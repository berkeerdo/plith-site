---
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-900 py-12">
  <div class="container-narrow flex flex-col items-center justify-between gap-6 sm:flex-row">
    <div class="flex items-center gap-3">
      <img src="/logo.png" alt="Plith" class="h-8 w-8" width="256" height="256" />
      <div>
        <p class="font-display font-semibold">Plith</p>
        <p class="text-xs text-neutral-500">
          A <a href="https://praxvon.com" class="underline decoration-neutral-700 underline-offset-2 hover:text-white" rel="noopener">Praxvon</a> product · MIT licensed
        </p>
      </div>
    </div>

    <nav class="flex items-center gap-6 text-sm text-neutral-400">
      <a href="https://github.com/berkeerdo/Plith" class="hover:text-white" rel="noopener">GitHub</a>
      <a href="https://github.com/berkeerdo/Plith/releases" class="hover:text-white" rel="noopener">Releases</a>
      <a href="https://github.com/berkeerdo/Plith/blob/main/LICENSE" class="hover:text-white" rel="noopener">License</a>
    </nav>

    <p class="text-xs text-neutral-600">© {year} Berke Erdoğan</p>
  </div>
</footer>
